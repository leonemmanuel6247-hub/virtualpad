{
  "expo": {
    "name": "VirtualPad",
    "slug": "virtualpad",
    "version": "0.1.0",
    "orientation": "landscape",
    "platforms": [
      "android"
    ],
    "android": {
      "package": "com.example.virtualpad",
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "BLUETOOTH",
        "BLUETOOTH_ADMIN",
        "BLUETOOTH_CONNECT",
        "BLUETOOTH_SCAN"
      ]
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "kotlinVersion": "1.9.25",
            "usesCleartextTraffic": true,
            "minSdkVersion": 28
          }
        }
      ]
    ]
  }
}
